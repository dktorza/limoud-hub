# ============================================================
# Limoud Hub — variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# Ne committez JAMAIS le fichier .env.
# ============================================================

# Flask
SECRET_KEY=changez-moi-en-production
FLASK_ENV=development
FLASK_DEBUG=False

# Base de données (chemin absolu recommandé en production)
# DATABASE_PATH=/home/votre_compte/limoud_data/limoud.db

# Dossiers de sortie (laisser vide = sous data/ par défaut)
# UPLOAD_FOLDER=
# BADGE_OUTPUT_FOLDER=
# LIVRET_OUTPUT_FOLDER=

# Email SMTP
MAIL_SERVER=smtp.o2switch.net
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=intranet@limoud.org

# HelloAsso API
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORG_SLUG=limoud-france

# SharePoint / Azure AD (POC)
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_URL=https://limoudfrance.sharepoint.com/sites/LimoudOrga

# SMS MFA (OVH)
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
OVH_SMS_SERVICE=
